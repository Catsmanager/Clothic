# Supabase 환경변수 — 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다.
# Supabase Dashboard > Project Settings > API 에서 확인.
# EXPO_PUBLIC_ 접두사는 Expo가 클라이언트 번들에 주입하기 위한 규칙이다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spring Boot 서버 주소 (선택). 비워 두면 기존처럼 Supabase에서 직접 옷 목록을 조회한다.
# 설정하면 내 옷 조회/기본 옷 추가는 GET/POST <주소>/api/items 를 접근 토큰과 함께 호출한다.
# 실기기에서는 localhost 대신 개발 컴퓨터의 네트워크 주소를 쓴다. 예: http://192.168.0.10:8080
EXPO_PUBLIC_CLOTHIC_API_URL=

{
  "schemaVersion": 4,
  "id": "habit-journey-frontend-v6",
  "version": 6,
  "purpose": "Executable core-test pass count for Clothic's deterministic repeat-record journey",
  "primaryMetric": {
    "name": "core_test_pass_count",
    "direction": "higher",
    "epsilon": 0,
    "target": 15,
    "regex": "(?m)^# pass ([0-9]+)$"
  },
  "execution": {
    "command": [
      "node",
      "--import",
      "tsx",
      "--test",
      "--test-reporter=tap",
      "tests/coreDataState.test.mjs",
      "tests/dateTransitions.test.mjs",
      "tests/retentionLogic.test.mjs"
    ],
    "repeat": 1,
    "timeoutSeconds": 120,
    "cwd": "frontend",
    "environment": {
      "inherit": [
        "HOME",
        "PATH",
        "TMPDIR"
      ],
      "set": {
        "CI": "true",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TZ": "Asia/Seoul"
      }
    }
  },
  "gates": [
    {
      "id": "source-contract-v4",
      "command": [
        "node",
        "scripts/check-user-flow-contract-v4.mjs"
      ],
      "repeat": 1,
      "timeoutSeconds": 30,
      "cwd": "frontend",
      "environment": {
        "inherit": [
          "HOME",
          "PATH",
          "TMPDIR"
        ],
        "set": {
          "CI": "true",
          "LANG": "C.UTF-8",
          "LC_ALL": "C.UTF-8",
          "TZ": "Asia/Seoul"
        }
      }
    },
    {
      "id": "static",
      "command": [
        "npm",
        "run",
        "verify:static"
      ],
      "repeat": 1,
      "timeoutSeconds": 300,
      "cwd": "frontend",
      "environment": {
        "inherit": [
          "HOME",
          "PATH",
          "TMPDIR"
        ],
        "set": {
          "CI": "true",
          "LANG": "C.UTF-8",
          "LC_ALL": "C.UTF-8",
          "TZ": "Asia/Seoul"
        }
      }
    }
  ],
  "fixedContext": {
    "timezone": "Asia/Seoul",
    "clock": "2026-07-27T12:00:00+09:00",
    "seed": 20260727,
    "users": [
      "user-a",
      "user-b"
    ],
    "windowDays": 30
  },
  "fixtureFiles": [
    ".prettierignore",
    ".prettierrc",
    "HARNESS/fixtures/habit-journey-v1.json",
    "frontend/app.json",
    "frontend/eslint.config.js",
    "frontend/package-lock.json",
    "frontend/package.json",
    "frontend/scripts/check-avatar-assets.mjs",
    "frontend/scripts/check-user-flow-contract-v4.mjs",
    "frontend/tests/coreDataState.test.mjs",
    "frontend/tests/dateTransitions.test.mjs",
    "frontend/tests/retentionLogic.test.mjs",
    "frontend/tsconfig.json",
    "HARNESS/evaluator-v6-habit.json"
  ],
  "limitations": [
    "This is a deterministic product-flow proxy, not observed D1 or D7 retention.",
    "The source-contract command is a guardrail gate, not the primary metric.",
    "Browser interaction, accessibility, and device behavior remain separate manual gates.",
    "Version 6 adapts repository paths to frontend/; old manifest hashes and results remain historical evidence, not comparable pairs."
  ]
}

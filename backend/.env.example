# 비밀값은 .env.local에만 넣는다. python3 scripts/run-local.py로 읽어서 실행한다.
CLOTHIC_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
CLOTHIC_AUTH_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# 공식 인증서를 내려받은 실제 절대 경로를 sslrootcert에 넣는다.
# IPv4 개발 환경은 관리 API/Connect 화면에서 확인한 shared session pooler(5432)를 사용한다.
CLOTHIC_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=<absolute-ca-path>&connectTimeout=10&socketTimeout=15
CLOTHIC_DB_USERNAME=<backend-role>.<project-ref>
CLOTHIC_DB_PASSWORD=
CLOTHIC_DB_POOL_SIZE=2

# 브라우저 개발 서버의 정확한 출처. 네이티브 전용이면 비워 둔다.
CLOTHIC_WEB_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

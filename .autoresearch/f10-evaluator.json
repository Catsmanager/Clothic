{
  "schemaVersion": 4,
  "id": "outfit-diary-store-f10",
  "version": 1,
  "purpose": "F-10 partial diary update ordering, confirmed-state recovery, account and delete races",
  "primaryMetric": {
    "name": "passed_outfit_store_cases",
    "direction": "higher",
    "epsilon": 0,
    "target": 32,
    "regex": "(?m)^# pass ([0-9]+)$"
  },
  "execution": {
    "command": [
      "node",
      "--import",
      "tsx",
      "--test",
      "--test-reporter=tap",
      "tests/outfitStore.test.mjs"
    ],
    "repeat": 1,
    "timeoutSeconds": 30,
    "cwd": "frontend",
    "environment": {
      "inherit": ["HOME", "PATH", "TMPDIR"],
      "set": {
        "CI": "true",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TZ": "Asia/Seoul"
      }
    }
  },
  "gates": [
    {
      "id": "source-contract-v4",
      "command": ["node", "scripts/check-user-flow-contract-v4.mjs"],
      "repeat": 1,
      "timeoutSeconds": 30,
      "cwd": "frontend",
      "environment": {
        "inherit": ["HOME", "PATH", "TMPDIR"],
        "set": {
          "CI": "true",
          "LANG": "C.UTF-8",
          "LC_ALL": "C.UTF-8",
          "TZ": "Asia/Seoul"
        }
      }
    },
    {
      "id": "static",
      "command": ["npm", "run", "verify:static"],
      "repeat": 1,
      "timeoutSeconds": 300,
      "cwd": "frontend",
      "environment": {
        "inherit": ["HOME", "PATH", "TMPDIR"],
        "set": {
          "CI": "true",
          "LANG": "C.UTF-8",
          "LC_ALL": "C.UTF-8",
          "TZ": "Asia/Seoul"
        }
      }
    }
  ],
  "fixedContext": {
    "timezone": "Asia/Seoul",
    "clock": "2026-11-12T12:00:00+09:00",
    "users": ["81111111-1111-4111-8111-111111111111", "82222222-2222-4222-8222-222222222222"],
    "requestId": "91111111-1111-4111-8111-111111111111"
  },
  "fixtureFiles": [
    ".prettierignore",
    ".prettierrc",
    "frontend/app.json",
    "frontend/eslint.config.js",
    "frontend/package-lock.json",
    "frontend/package.json",
    "frontend/scripts/check-avatar-assets.mjs",
    "frontend/scripts/check-user-flow-contract-v4.mjs",
    "frontend/scripts/check-wardrobe-ownership-contract.mjs",
    "frontend/tests/wardrobeOwnershipEvaluator.test.mjs",
    "frontend/tsconfig.json",
    "supabase/migrations/20260803000100_add_catalog_ownership_to_items.sql",
    "frontend/lib/database.types.ts",
    ".autoresearch/f10-evaluator.json",
    "frontend/tests/outfitStore.test.mjs"
  ],
  "limitations": [
    "Mocked HTTP and platform boundaries; actual Zustand and store source are executed.",
    "Pass counts are deterministic requirements checks, not observed user behavior or retention.",
    "Separate real HTTP/PostgreSQL and live two-account checks are required before F-08 completion."
  ]
}
